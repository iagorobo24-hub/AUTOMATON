# AUTOMATON v2 - Git Ignore

# Dependencies
node_modules/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Databases
*.db
*.sqlite
*.sqlite3

# Environment files
.env
.env.local
.env.*
!.env.example

# Build outputs
dist/
build/
*.egg-info/

# Logs and generated test evidence
*.log
logs/
npm-debug.log*
yarn-debug.log*
test_reports/*
!test_reports/.gitkeep
test_result.md
coverage/
.pytest_cache/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Python virtual environments
venv/
.venv/
env/

# Electron
electron/dist/
electron/out/
