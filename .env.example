# AUTOMATON v2 - Environment Configuration
# Copy to .env where needed.

# Frontend API base. frontend/src/lib/api.js appends /api exactly once.
VITE_API_URL=http://127.0.0.1:8000

# Optional orchestration defaults used by local tooling/Electron helpers.
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://127.0.0.1:8000

# Legacy Mongo/Live trading variables are intentionally omitted here because
# backend/app/main.py does not mount that architecture.
